        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fact": {
                "type": "string"
              },
              "source_url": {
                "type": "string"
              },
              "capture_method": {
                "type": "string"
              },
              "evidence_excerpt_or_locator": {
                "type": "string"
              },
          "evidence_path": {
            "type": "string"
          },
              "confidence": {
                "type": "string"
              }
            },
            "required": [
              "fact",
              "source_url",
          "capture_method",
          "evidence_excerpt_or_locator",
          "evidence_path"
            ],
            "additionalProperties": true
          }
        },
        "contact": {
          "type": "object",
          "properties": {},

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Website POC structured evidence records",
  "description": "Schema for the normalized evidence package emitted by the skill and by chatgpt_automation/scripts/package_website_poc.py after workflow-specific assembly. Native workflow diagnostics are also retained as raw evidence.",
  "oneOf": [
    {
      "$ref": "#/$defs/run"
    },
    {
      "$ref": "#/$defs/source_facts"
    },
    {
      "$ref": "#/$defs/generation_context"
    },
    {
      "$ref": "#/$defs/candidate_inputs"
    },
    {
      "$ref": "#/$defs/qa"
    },
    {
      "$ref": "#/$defs/repairs"
    },
    {
      "$ref": "#/$defs/image_review"
    },
    {
      "$ref": "#/$defs/visual_review"
    },
    {
      "$ref": "#/$defs/final_status"
    },
    {
      "$ref": "#/$defs/candidate_ledger"
    }
  ],
  "$defs": {
    "run": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "record_type": {
          "type": "string",
          "const": "run"
        },
        "run_id": {
          "type": "string"
        },
        "execution_mode": {
          "type": "string",
          "enum": ["skill", "workflow"]
        },
        "runtime_profile": {
          "type": "string",
          "enum": ["full_parity", "browser_github_limited", "limited", "workflow"]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "output_root": {
          "type": "string"
        },
        "source_url": {
          "type": "string"
        },
        "candidate_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deliverables": {
          "type": "object",
          "minProperties": 0,
          "maxProperties": 3,
          "propertyNames": {
            "pattern": "^candidate-(forty|landed|story)\\.html$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "bytes": {"type": "integer", "minimum": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "qa_html_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "package_status": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "UNVERIFIED"]},
              "candidate_id": {"type": "string", "minLength": 1}
            },
            "required": ["path", "bytes", "sha256", "qa_html_sha256", "package_status", "candidate_id"],
            "additionalProperties": true
          }
        },
        "evidence_index": {
          "type": "string"
        },
        "tool_availability": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": {
            "type": "object",
            "properties": {
              "status": {"type": "string", "enum": ["available", "unavailable", "not_checked"]},
              "tool": {"type": "string"},
              "evidence": {"type": "string"}
            },
            "required": ["status"],
            "additionalProperties": true
          }
        },
        "failure_summary": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "UNVERIFIED",
            "NOT_REQUIRED"
          ]
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "run_id",
        "execution_mode",
        "runtime_profile",
        "created_at",
        "output_root",
        "source_url",
        "candidate_ids",
        "deliverables",
        "evidence_index",
        "tool_availability",
        "failure_summary",
        "status"
      ],
      "allOf": [
        {
          "if": {
            "properties": {"execution_mode": {"const": "workflow"}},
            "required": ["execution_mode"]
          },
          "then": {
            "properties": {"runtime_profile": {"const": "workflow"}}
          }
        },
        {
          "if": {
            "properties": {
              "execution_mode": {"const": "skill"},
              "status": {"const": "PASS"}
            },
            "required": ["execution_mode", "status"]
          },
          "then": {
            "properties": {"runtime_profile": {"const": "full_parity"}}
          }
        }
      ],
      "additionalProperties": true
    },
    "source_facts": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",

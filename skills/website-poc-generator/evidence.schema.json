          "additionalProperties": true
        },
        "logo": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": true
        },
        "form_schema": {
          "type": "array",
          "items": {
            "type": "object",
        "properties": {
          "source_url": {"type": "string"},
          "capture_method": {"type": "string", "enum": ["static_html", "rendered_dom"]},
          "evidence_path": {"type": "string"}
        },
        "required": ["source_url", "capture_method", "evidence_path"],
            "additionalProperties": true
          }
        },
        "source_assets": {
          "type": "array",
          "items": {
            "type": "object",
        "properties": {
          "url": {"type": "string"},
          "source_page": {"type": "string"},
          "discovery_method": {"type": "string"},
          "capture_method": {"type": "string", "enum": ["static_html", "rendered_dom"]},
          "evidence_path": {"type": "string"}
        },
        "required": ["url", "source_page", "discovery_method", "capture_method", "evidence_path"],
            "additionalProperties": true
          }
        },
        "user_supplied_facts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fact": {"type": "string", "minLength": 1},
              "provided_by": {"type": "string", "minLength": 1},
              "evidence_path": {"type": "string", "minLength": 1}
            },
            "required": ["fact", "provided_by", "evidence_path"],
            "additionalProperties": true
          }
        },
        "unsupported_or_missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "run_id",
        "created_at",
        "source_url",
        "pages_reviewed",
        "facts"
      ],
      "additionalProperties": true
    },
